# Last Sietch portal API server: environment template.
#
# Copy to .env next to main.py (or point the systemd EnvironmentFile at it) and
# fill in real values. Values with spaces or angle brackets are quoted so the file
# is safe both as a systemd EnvironmentFile and when sourced by a shell.
# Every default here fails CLOSED: with this file untouched
# the server boots, the admin surface works, and each player-facing feature stays
# dark until its switch is set. Never commit the filled-in copy.

# --- Required -----------------------------------------------------------------
# Relay base URL (docs/15). Empty = no game-host access at all.
LASTSIETCH_RELAY_URL=
# Shared secret with the relay, sent as the X-API-Key header.
LASTSIETCH_RELAY_API_KEY=
# Signs admin session cookies. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LASTSIETCH_SESSION_SECRET=
# SQLite file for the server's own state (accounts, links, ledgers, caches).
LASTSIETCH_DB_PATH=/opt/lastsietch-admin/admin.db

# --- Listen port (single-box mode) --------------------------------------------
# The telemetry API also defaults to 8078. When both run on one host, move one.
LASTSIETCH_ADMIN_PORT=8078

# --- Player portal sign-in (Discord OAuth, docs/20 section 5) ------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match the redirect registered in the Discord developer portal exactly.
DISCORD_OAUTH_REDIRECT_URI="https://<your portal hostname>/portal/oauth/callback"
# Signs the OAuth state and the portal session cookie. Two different secrets.
PORTAL_OAUTH_STATE_SECRET=
PORTAL_SESSION_SECRET=
# Hostnames that serve the portal at their root (comma list). Empty = the
# portal is only reachable under /portal/v2/ on the admin host.
PORTAL_ROOT_HOSTS=
# Shown in the portal footer and on the start page.
PORTAL_DISCORD_INVITE_URL=

# --- Passkeys (WebAuthn), off until both are set -------------------------------
LASTSIETCH_PORTAL_AUTH_ENABLED=0
LASTSIETCH_PORTAL_AUTH_RP_ID=
LASTSIETCH_PORTAL_AUTH_ORIGIN=
# In-game code sign-in (dispatcher must expose servercmd, docs/12).
LASTSIETCH_PORTAL_GAME_AUTH_ENABLED=0

# --- Feature switches (1 = on). Each one is also a runtime toggle in the ------
# --- admin Systems panel, which writes feature_flags.json in the runtime dir. ---
LASTSIETCH_AUGMENT_ENABLED=0
LASTSIETCH_CHAT_ENABLED=0
LASTSIETCH_EXPORT_ENABLED=0
LASTSIETCH_ITEM_TRANSFER_ENABLED=0
LASTSIETCH_KARUM_ENABLED=0
LASTSIETCH_KARUM_WTB_ENABLED=0
LASTSIETCH_MARKET_SELL_BACKPACK_ENABLED=0
LASTSIETCH_MARKET_WATCH_ENABLED=0
LASTSIETCH_MULTIACCOUNT_ENABLED=0
LASTSIETCH_MULTIACCOUNT_REQUIRE_QUIZ=0
LASTSIETCH_PORTAL_PROFILES_ENABLED=0
LASTSIETCH_REFINERY_ENABLED=0
LASTSIETCH_REPORTS_ENABLED=0
LASTSIETCH_STORAGE_MOVE_ENABLED=0
LASTSIETCH_STORAGE_PAWN_MOVE_ENABLED=0
LASTSIETCH_BLUEPRINT_PUBLISH_ENABLED=0
LASTSIETCH_BLUEPRINT_IMPORT_ENABLED=0
LASTSIETCH_REPAIR_ALL_ENABLED=1
LASTSIETCH_REPAIR_BOX_ENABLED=1
LASTSIETCH_REPAIR_VEHICLE_ENABLED=1
LASTSIETCH_EVENT_REMINDERS_ENABLED=1

# --- Caps and windows (defaults shown) -----------------------------------------
GIFT_MAX_PER_DAY=20
GIFT_MAX_PER_PAIR_PER_DAY=5
GIFT_MAX_AMOUNT=5000000
LASTSIETCH_BLUEPRINT_PUBLISH_DAILY_CAP=10
LASTSIETCH_BLUEPRINT_IMPORT_DAILY_CAP=10
LASTSIETCH_REPAIR_BOX_WINDOW_MIN=120
LASTSIETCH_REPAIR_BOX_CAP=3
LASTSIETCH_REPAIR_VEHICLE_WINDOW_MIN=120
LASTSIETCH_REPAIR_VEHICLE_CAP=3
LASTSIETCH_REPAIR_ALL_WINDOW_HR=24
LASTSIETCH_REPAIR_ALL_CAP=1
LASTSIETCH_MARKET_WATCH_INTERVAL=60
LASTSIETCH_MARKET_WATCH_MAX_PER_ACCOUNT=25
LASTSIETCH_EVENT_REMINDER_INTERVAL=60

# --- Deep Desert Coriolis cycle (spice field rotation) --------------------------
# ISO timestamp of any past reset on YOUR server and the cycle length in days.
LASTSIETCH_CORIOLIS_ANCHOR=2026-06-16T05:00:00+00:00
LASTSIETCH_CORIOLIS_PERIOD_DAYS=14
LASTSIETCH_SPICE_CANDIDATE_STALE_HOURS=12

# --- Paths (defaults derive from LASTSIETCH_DB_PATH when unset) -----------------
# LASTSIETCH_BLUEPRINT_BLOB_DIR=/opt/lastsietch-admin/blueprints
# LASTSIETCH_MARKET_HISTORY_DB_PATH=/opt/lastsietch-admin/market_history.db
# LASTSIETCH_MIRROR_DB_PATH=/opt/lastsietch-admin/mirror.sqlite
# Writable directory for runtime state (feature_flags.json, layout overrides).
# Defaults to the data/ directory of the checkout, which is fine for one host.
# LASTSIETCH_PORTAL_RUNTIME_DIR=/opt/lastsietch-admin/data
# Local telemetry SQLite, only when the telemetry collector runs on THIS host.
# LASTSIETCH_TELEMETRY_DB_PATH=
# Announcement text shown on the portal home (file path, optional).
# PORTAL_ANNOUNCE_FILE=

# --- Read-model mirror (advanced, off by default) -------------------------------
LASTSIETCH_PORTAL_MIRROR_READS=0
LASTSIETCH_MIRROR_PULL_INTERVAL=30
LASTSIETCH_MIRROR_MAX_STALE=300

# --- Discord notifications from the server (optional) ---------------------------
DISCORD_BOT_TOKEN=
DISCORD_CH_BOTLOGS=
DISCORD_CH_EVENTS=

# --- Metrics sampler (optional) ---------------------------------------------------
LASTSIETCH_SAMPLE_INTERVAL_SEC=60
LASTSIETCH_FAST_INTERVAL_SEC=10
LASTSIETCH_FAST_DURATION_SEC=3600
LASTSIETCH_METRICS_RETENTION_DAYS=7

# --- QA harness (leave empty in production) ---------------------------------------
LASTSIETCH_QA_KEY=
LASTSIETCH_QA_IDENTITIES=

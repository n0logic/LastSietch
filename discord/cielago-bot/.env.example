# Copy to .env and fill in real values. NEVER commit .env.

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Last Sietch guild (server) ID (pre-filled; change only if the server changes)
LAST_SIETCH_GUILD_ID=

# Admin Discord user IDs (comma-separated, no spaces)
# the founders' user ids, comma separated
CIELAGO_ADMIN_IDS=

# Audit log channel ID — the cielago-audit channel.
# Optional: leave blank to log to disk only, or run /channel-template to create it then paste its ID.
CIELAGO_AUDIT_CHANNEL_ID=

# Optional: where the JSONL audit log is written (relative to the bot's working dir)
CIELAGO_AUDIT_LOG_PATH=logs/cielago-audit.jsonl

# Optional: where giveaway state is persisted (relative to the bot's working dir).
# Survives restarts; the Enter button keeps working after a reboot.
CIELAGO_GIVEAWAY_DATA_PATH=data/giveaways.json

# Optional: Join-to-Create trigger voice channel ID. Members who join this channel get a
# fresh temp voice channel named after their game. Leave blank to auto-detect a voice
# channel named "Join to Create" (created by /channel-template).
CIELAGO_JTC_TRIGGER_CHANNEL_ID=

# Optional: log level (DEBUG / INFO / WARNING / ERROR)
CIELAGO_LOG_LEVEL=INFO

# Dune server-status digest (daily 09:00 ET, weekly Sun 18:00 ET) -> #dune-server-info.
# Leave the channel blank to disable the digest entirely.
CIELAGO_DUNE_STATUS_CHANNEL_ID=
# lastsietch-relay base URL (the web host localhost) + API key for the stats endpoint.
# The digest is disabled if the API key is blank.
CIELAGO_RELAY_BASE_URL=http://127.0.0.1:8077
CIELAGO_RELAY_API_KEY=

# Market price-alert DMs. Polls the admin backend (same box) for fired portal
# price watches and DMs the player. Disabled if the poll key is blank. The key
# must match the admin backend's LASTSIETCH_PORTAL_ALERT_POLL_KEY.
CIELAGO_ADMIN_BASE_URL=http://127.0.0.1:8078
CIELAGO_ALERT_POLL_KEY=
CIELAGO_MARKET_ALERT_INTERVAL=120

# Feedback channel — the default channel the assistant watches. Also the source
# the retired tracker's JSON is migrated from on first assistant load.
CIELAGO_FEEDBACK_CHANNEL_ID=
CIELAGO_TRACKER_DATA_PATH=data/tracker.json

# --- Cielago Assistant (Phase 0/1: support triage, dedup, feature requests) ---
# Master on/off. The /assistant disable kill switch overrides this at runtime.
CIELAGO_ASSISTANT_ENABLED=true
# State DB (WAL). The bot only ever writes here — never the game DB or mirror.
CIELAGO_ASSISTANT_DB_PATH=data/support.sqlite
# Where ticket + feature-request embeds are posted. Defaults to the 🛡️｜mod-chat
# channel (ADMIN category; set your own id); override only to relocate.
CIELAGO_ASSISTANT_MOD_CHANNEL_ID=
# Comma-separated channel ids to watch. Blank = just the feedback channel above.
CIELAGO_ASSISTANT_WATCH_CHANNEL_IDS=
# The owner's user id, pinged on Escalate-to-owner. Blank = ping the admin ids.
CIELAGO_ASSISTANT_OWNER_ID=
# Role id pinged on urgent tickets (server-down / exploit / harassment). Blank =
# ping the admin ids.
CIELAGO_ASSISTANT_MOD_ROLE_ID=
# bge-small ONNX model dir (tokenizer.json + model.onnx). Stage it on the host;
# DO NOT commit the 130MB model. Blank/missing = deterministic hashing fallback.
CIELAGO_ASSISTANT_EMBED_MODEL_DIR=
# Optional cosine dup-cutoff override (else the embedder backend's default:
# bge ~0.84, hashing ~0.55). Raise to dedup less aggressively.
CIELAGO_ASSISTANT_DUP_THRESHOLD=

# Last Sietch Dune telemetry logger - environment template.
# Copy to /opt/lastsietch-telemetry/telemetry.env and review the intervals.
#
# DB_* and GAME_* are left blank on purpose: run-telemetry.sh resolves them
# fresh from k3s at every start (the game-DB ClusterIP and the funcom-* hash
# change on a battlegroup rebuild). Do not hard-code them here.

# ---- logger SQLite store ----
TELEMETRY_DB=/var/lib/lastsietch-telemetry/telemetry.db

# ---- game DB (filled by the launcher - leave blank) ----
#DB_HOST=
DB_PORT=15433
DB_USER=postgres
#DB_PASS=
DB_NAME=dune
#GAME_NS=
#GAME_POD=

# ---- stream / job cadences (seconds) ----
PRESENCE_INTERVAL=300
WORLD_INTERVAL=300
CONNECTIONS_INTERVAL=300
ROSTER_INTERVAL=300
COMBAT_INTERVAL=90
VEHICLE_INTERVAL=90
# Live-map player-position sweep. 5s is the agreed cadence (telemetry floor);
# the player_positions table self-prunes to a ~15-minute rolling window.
POSITIONS_INTERVAL=5
FLIGHT_JOB_INTERVAL=900
ROLLUP_INTERVAL=86400

# Grant-ledger harvest (dune.ls_progression_grants -> grant_events).
GRANT_EVENTS_INTERVAL=60

# Progression snapshots (char level / XP / SP / intel via FLevelComponent).
# Insert-on-change; 120s catches a multi-level char_xp grant within one sweep.
PROGRESSION_INTERVAL=120

# Transfer / removal event harvest (dune.account_removal_log +
# dune.character_transfer_imports -> transfer_events). 60s is the first deploy
# cadence; tune if either source table grows hot.
TRANSFERS_INTERVAL=60

# Account-prune sweeper: deletes rows from account-keyed telemetry tables
# (player_progression, player_progression_levelups, roster_snapshot, presence)
# whose account_id is no longer in dune.accounts. Bails on empty live set or
# live count below the MIN_LIVE floor (defensive against transient DB glitches).
ACCOUNTS_SWEEP_INTERVAL=3600
ACCOUNTS_SWEEP_MIN_LIVE=5

# ---- combat harvest ----
# Seconds of cursor overlap re-read on restart (dedup absorbs the repeats).
COMBAT_CURSOR_OVERLAP=60

# ---- flight-distance teleport filter ----
# Per-segment speed ceiling in Unreal cm/s. Loose first guess (~4000 m/s);
# tune against real vehicle_positions data after ~a week (see RUNBOOK step 11).
TELEPORT_MAX_SPEED_CMS=400000

# ---- misc ----
GEOIP_API=http://ip-api.com/json/
LOG_LEVEL=INFO

# ---- read API ----
API_BIND=127.0.0.1
API_PORT=8078

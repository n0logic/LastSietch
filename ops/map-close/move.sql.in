-- Map close: move every base, vehicle and container on the closing instance (@SRC_NAME@, partition @SRC_PART@,
-- dim @SRC_DIM@) to the destination (@DST_NAME@, partition @DST_PART@, dim @DST_DIM@) at the same coordinates, plus
-- the characters parked there. One transaction. Generated by map-close.py from move.sql.in; run ONLY through
-- map-close.sh. Written for the 2026-10-28 Kulon close and proved there.
--
-- Why this is a pure re-key: nothing below the actor row carries a partition. building_instances, placeables,
-- inventories, items, vehicle_modules, permission_actor(_rank), landclaim_segments and fgl entities hang off
-- actors.id; only actors.(map, partition_id, dimension_index) says where a thing loads (information_schema
-- scan, 2026-10-25). The engine's save_actors upserts partition_id from the SAVING server, so
-- a closing pod that still holds these actors in RAM would write them back to @SRC_PART@. Hence the guard: neither
-- partition may have a live game server (dune.active_server_ids = servers holding a DB session).
--
-- Rule 1 (CLOSE-PLAN): the move reads only what is in the DB after the closing pod stopped. The @REC@_* tables
-- are written inside this transaction, so the record IS the move input, row for row; the revert reads them.
--
-- psql variables (map-close.sh sets them):
--   expect_actors      count of actors the post-stop inventory says will move (guard against drift)
--   hold_totems        comma list of totems whose whole base stays put (overlap holds)
--   recovery_vehicles  comma list of vehicles that go to their owner's Vehicle Recovery instead ('0' = none);
--                      (at the Kulon close: only vehicles inside a destination base)
--   pawn_overrides     jsonb {"<pawn id>": [x, y, z]} for characters that must not log in where they stood
--   end                COMMIT or ROLLBACK
\set ON_ERROR_STOP on
-- search_path is load-bearing: the stock procs and the cleanup_orphaned_entities trigger use unqualified names.
SET search_path TO dune, public;
BEGIN ISOLATION LEVEL REPEATABLE READ;
SET LOCAL statement_timeout = '300s';
SET LOCAL lock_timeout = '10s';
SELECT set_config('mapclose.expect_actors', :'expect_actors', true),
       set_config('mapclose.hold_totems', :'hold_totems', true),
       set_config('mapclose.recovery_vehicles', :'recovery_vehicles', true),
       set_config('mapclose.pawn_overrides', :'pawn_overrides', true);
LOCK TABLE dune.actors, dune.permission_actor, dune.permission_actor_rank, dune.recovered_vehicles,
           dune.player_respawn_locations, dune.encrypted_player_state, dune.player_travel_state
  IN SHARE ROW EXCLUSIVE MODE;

DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM dune.world_partition w JOIN dune.active_server_ids s ON s.server_id = w.server_id
              WHERE w.partition_id IN (@SRC_PART@, @DST_PART@)) THEN
    RAISE EXCEPTION 'map_close_move_partition_live: a game server for partition @SRC_PART@ or @DST_PART@ holds a DB session';
  END IF;
  IF EXISTS (SELECT 1 FROM dune.player_state WHERE online_status <> 'Offline') THEN
    RAISE EXCEPTION 'map_close_move_player_online';
  END IF;
  IF (SELECT count(*) FROM dune.world_partition WHERE (partition_id, map, dimension_index) IN ((@SRC_PART@, '@PART_MAP@', @SRC_DIM@), (@DST_PART@, '@PART_MAP@', @DST_DIM@))) <> 2 THEN
    RAISE EXCEPTION 'map_close_move_partition_identity';
  END IF;
  IF to_regclass('dune.@REC@_actors') IS NOT NULL THEN
    RAISE EXCEPTION 'map_close_move_already_ran: @REC@_actors exists';
  END IF;
END $$;

-- Bases held on the closing instance (overlap with a destination base): their totem's Actor entity and everything it owns.
CREATE TEMP TABLE k_hold ON COMMIT DROP AS
  WITH ent AS (SELECT afe.entity_id FROM dune.actor_fgl_entities afe
                WHERE afe.slot_name = 'Actor'
                  AND afe.actor_id = ANY (string_to_array(current_setting('mapclose.hold_totems'), ',')::bigint[]))
  SELECT unnest(string_to_array(current_setting('mapclose.hold_totems'), ',')::bigint[]) id
  UNION SELECT p.id FROM dune.placeables p JOIN ent ON ent.entity_id = p.owner_entity_id
  UNION SELECT bi.building_id FROM dune.building_instances bi JOIN ent ON ent.entity_id = bi.owner_entity_id;

CREATE TABLE dune.@REC@_meta AS
  SELECT now() AS ran_at, current_setting('mapclose.hold_totems') AS hold_totems,
         current_setting('mapclose.recovery_vehicles') AS recovery_vehicles,
         current_setting('mapclose.pawn_overrides') AS pawn_overrides, NULL::timestamptz AS reverted_at;

-- The move set: every placed thing on the closing instance that a player built, owns or parked. Not moved: CHOAM terminals
-- (the destination has its own), held bases, recovery vehicles, packed BRT backups / vehicle backups / recoveries
-- (state <> Default; those belong to a character and are placed wherever the character is).
CREATE TABLE dune.@REC@_actors AS
  SELECT a.id, a.class, a.map, a.partition_id, a.dimension_index, a.state, a.serial, a.transform,
         CASE WHEN v.id IS NOT NULL THEN 'vehicle' WHEN b.id IS NOT NULL THEN 'building' ELSE 'placeable' END AS kind
    FROM dune.actors a
    LEFT JOIN dune.vehicles v ON v.id = a.id
    LEFT JOIN dune.buildings b ON b.id = a.id
    LEFT JOIN dune.placeables p ON p.id = a.id
   WHERE a.partition_id = @SRC_PART@ AND a.dimension_index = @SRC_DIM@ AND a.state = 'Default'
     AND (v.id IS NOT NULL OR b.id IS NOT NULL OR p.id IS NOT NULL)
     AND a.class NOT LIKE '%ChoamExchangeTerminal%'
     AND a.id NOT IN (SELECT id FROM k_hold)
     AND a.id <> ALL (string_to_array(current_setting('mapclose.recovery_vehicles'), ',')::bigint[]);

DO $$ BEGIN
  IF (SELECT count(*) FROM dune.@REC@_actors) <> current_setting('mapclose.expect_actors')::int THEN
    RAISE EXCEPTION 'map_close_move_count_drift: % actors in the move set, % expected',
      (SELECT count(*) FROM dune.@REC@_actors), current_setting('mapclose.expect_actors');
  END IF;
  -- Overlap gate: no moved piece or placeable may share a 10 m cell, at overlapping height, with the destination's.
  IF EXISTS (
    WITH ent AS (SELECT afe.entity_id, a.partition_id p FROM dune.actors a JOIN dune.totems t ON t.id = a.id
                   JOIN dune.actor_fgl_entities afe ON afe.actor_id = a.id AND afe.slot_name = 'Actor'
                  WHERE a.state = 'Default'
                    AND ((a.partition_id = @DST_PART@) OR a.id IN (SELECT id FROM dune.@REC@_actors))),
    pts AS (SELECT ent.p, bi.transform[0]::float8 x, bi.transform[1]::float8 y, bi.transform[2]::float8 z
              FROM ent JOIN dune.building_instances bi ON bi.owner_entity_id = ent.entity_id
            UNION ALL
            SELECT ent.p, (a.transform).location.x, (a.transform).location.y, (a.transform).location.z
              FROM ent JOIN dune.placeables pl ON pl.owner_entity_id = ent.entity_id JOIN dune.actors a ON a.id = pl.id),
    cells AS (SELECT p, floor(x / 1000)::int cx, floor(y / 1000)::int cy, min(z) z0, max(z) z1 FROM pts GROUP BY 1, 2, 3)
    SELECT 1 FROM cells k JOIN cells m ON k.p = @SRC_PART@ AND m.p = @DST_PART@ AND k.cx = m.cx AND k.cy = m.cy
     WHERE k.z0 <= m.z1 + 500 AND m.z0 <= k.z1 + 500) THEN
    RAISE EXCEPTION 'map_close_move_overlap: a moving base shares a 10 m cell with a @DST_NAME@ base; run map-close.sh overlap';
  END IF;
  -- A recovery vehicle may carry: a child already out of the world (state <> Default, e.g. a container vehicle in
  -- recovery), or the pawn of an Active character that this move relocates with a pawn override (two such
  -- at the Kulon close, R2 2026-10-25). The travel_actor_parent row is left as is, exactly as stock
  -- store_recovered_vehicle leaves it (at the Kulon close 14 live Active pawns sat in recovered vehicles).
  -- Anything else (a vehicle, container or pawn still in the world) refuses.
  IF EXISTS (SELECT 1 FROM dune.travel_actor_parent t JOIN dune.actors c ON c.id = t.id
              WHERE t.parent_id = ANY (string_to_array(current_setting('mapclose.recovery_vehicles'), ',')::bigint[])
                AND c.state = 'Default'
                AND NOT (current_setting('mapclose.pawn_overrides')::jsonb ? c.id::text
                         AND EXISTS (SELECT 1 FROM dune.encrypted_player_state e
                                      WHERE e.player_pawn_id = c.id AND e.character_state = 'Active'))) THEN
    RAISE EXCEPTION 'map_close_move_recovery_vehicle_has_cargo: a recovery vehicle carries an in-world actor or a pawn without an override';
  END IF;
END $$;

-- Characters: every active character whose pawn is on the closing instance, plus anyone homed or routed to its dim.
CREATE TABLE dune.@REC@_characters AS
  SELECT e.id AS eps_id, e.account_id, acc."user" AS fls, e.player_pawn_id, pa.partition_id AS pawn_partition,
         pa.dimension_index AS pawn_dimension, pa.map AS pawn_map, pa.transform AS pawn_transform,
         e.player_controller_id, pc.partition_id AS ctrl_partition, pc.dimension_index AS ctrl_dimension,
         e.player_state_id, ps.partition_id AS state_partition, ps.dimension_index AS state_dimension,
         e.home_dimension_index, e.return_dimension_index, pts.login_target_dimension_index
    FROM dune.encrypted_player_state e
    JOIN dune.accounts acc ON acc.id = e.account_id
    LEFT JOIN dune.actors pa ON pa.id = e.player_pawn_id
    LEFT JOIN dune.actors pc ON pc.id = e.player_controller_id
    LEFT JOIN dune.actors ps ON ps.id = e.player_state_id
    LEFT JOIN dune.player_travel_state pts ON pts.fls_id = acc."user"
   WHERE e.character_state = 'Active'
     AND (pa.partition_id = @SRC_PART@ OR e.home_dimension_index = @SRC_DIM@ OR e.return_dimension_index = @SRC_DIM@
          OR pts.login_target_dimension_index = @SRC_DIM@);

CREATE TABLE dune.@REC@_respawns AS
  SELECT r.id, r.character_id, r.dimension FROM dune.player_respawn_locations r
   WHERE r.map = '@WORLD_MAP@' AND r.dimension = @SRC_DIM@ AND r.locator_actor_id IN (SELECT id FROM dune.@REC@_actors);

CREATE TABLE dune.@REC@_vehicle_perms AS
  SELECT pa.actor_id, pa.actor_name, pa.actor_type, pa.access_level, pa.is_child, pa.edited_by_player_id,
         r.player_id, r.rank
    FROM dune.permission_actor pa LEFT JOIN dune.permission_actor_rank r ON r.permission_actor_id = pa.actor_id
   WHERE pa.actor_id = ANY (string_to_array(current_setting('mapclose.recovery_vehicles'), ',')::bigint[]);

-- 1. Bases, placeables, containers (contents ride along by actor id), vehicles: re-key to the destination.
UPDATE dune.actors a SET partition_id = @DST_PART@, dimension_index = @DST_DIM@
  FROM dune.@REC@_actors z WHERE a.id = z.id;

-- 2. Respawn points whose locator (bed, totem, beacon, vehicle) moved with the base.
UPDATE dune.player_respawn_locations r SET dimension = @DST_DIM@
  FROM dune.@REC@_respawns z WHERE r.id = z.id AND r.character_id = z.character_id;

-- 3. Vehicles that cannot land (inside a destination base): Funcom's own transfer path, as in
--    _character_transfer_store_in_world_owned_vehicles_into_recovery: 'Migrated' recovery never expires.
SELECT dune.store_recovered_vehicle(v, 1.0, 'None', 'Migrated'::dune.recoveredvehiclereason)
  FROM unnest(string_to_array(current_setting('mapclose.recovery_vehicles'), ',')::bigint[]) v WHERE v > 0;
DELETE FROM dune.permission_actor WHERE actor_id IN (SELECT actor_id FROM dune.@REC@_vehicle_perms);

-- 4. Characters: stock offline move of the pawn (same spot unless overridden), then home / return / login dims.
-- (No coalesce here: a ROW of NULLs is not NULL to coalesce, which wrote a NULL location in the scratch test.)
SELECT dune.admin_move_offline_player_to_partition(c.fls, @DST_PART@,
         CASE WHEN o.v IS NULL THEN (c.pawn_transform).location
              ELSE ROW((o.v->>0)::float8, (o.v->>1)::float8, (o.v->>2)::float8)::dune.vector END)
  FROM dune.@REC@_characters c
  CROSS JOIN LATERAL (SELECT current_setting('mapclose.pawn_overrides')::jsonb -> c.player_pawn_id::text AS v) o
 WHERE c.pawn_partition = @SRC_PART@;
-- The stock proc moves only the pawn. Every live character keeps controller, PlayerState and pawn on the same
-- partition/dimension (checked at the Kulon close, 2026-10-25), and the closing partition leaves the CR in the
-- window (D7), so the controller and PlayerState actors follow the pawn.
UPDATE dune.actors a SET partition_id = @DST_PART@, dimension_index = @DST_DIM@
  FROM dune.@REC@_characters c
 WHERE c.pawn_partition = @SRC_PART@ AND a.partition_id = @SRC_PART@
   AND (a.id = c.player_controller_id OR a.id = c.player_state_id);
UPDATE dune.encrypted_player_state e SET home_dimension_index = @DST_DIM@
  FROM dune.@REC@_characters c WHERE e.id = c.eps_id AND c.home_dimension_index = @SRC_DIM@;
UPDATE dune.encrypted_player_state e SET return_dimension_index = @DST_DIM@
  FROM dune.@REC@_characters c WHERE e.id = c.eps_id AND c.return_dimension_index = @SRC_DIM@;
UPDATE dune.player_travel_state t SET login_target_dimension_index = @DST_DIM@
  FROM dune.@REC@_characters c WHERE t.fls_id = c.fls AND c.login_target_dimension_index = @SRC_DIM@;

-- Read back before COMMIT.
DO $$ BEGIN
  IF (SELECT count(*) FROM dune.actors a JOIN dune.@REC@_actors z ON z.id = a.id
       WHERE a.partition_id = @DST_PART@ AND a.dimension_index = @DST_DIM@ AND a.state = 'Default' AND a.map = '@WORLD_MAP@')
     <> (SELECT count(*) FROM dune.@REC@_actors) THEN
    RAISE EXCEPTION 'map_close_move_readback_actors';
  END IF;
  IF EXISTS (SELECT 1 FROM dune.actors a
               LEFT JOIN dune.vehicles v ON v.id = a.id LEFT JOIN dune.buildings b ON b.id = a.id
               LEFT JOIN dune.placeables p ON p.id = a.id
              WHERE a.partition_id = @SRC_PART@ AND a.state = 'Default' AND (v.id IS NOT NULL OR b.id IS NOT NULL OR p.id IS NOT NULL)
                AND a.class NOT LIKE '%ChoamExchangeTerminal%' AND a.id NOT IN (SELECT id FROM k_hold)) THEN
    RAISE EXCEPTION 'map_close_move_readback_left_behind';
  END IF;
  IF EXISTS (SELECT 1 FROM dune.player_state ps JOIN dune.actors a ON a.id = ps.player_pawn_id
              WHERE ps.character_state = 'Active' AND a.partition_id = @SRC_PART@) THEN
    RAISE EXCEPTION 'map_close_move_readback_pawns';
  END IF;
  IF EXISTS (SELECT 1 FROM dune.@REC@_characters c JOIN dune.actors a
               ON a.id IN (c.player_controller_id, c.player_state_id)
              WHERE c.pawn_partition = @SRC_PART@ AND (a.partition_id, a.dimension_index) IS DISTINCT FROM (@DST_PART@, @DST_DIM@)) THEN
    RAISE EXCEPTION 'map_close_move_readback_controllers';
  END IF;
  IF EXISTS (SELECT 1 FROM dune.@REC@_characters c JOIN dune.actors a ON a.id = c.player_pawn_id
              WHERE c.pawn_partition = @SRC_PART@
                AND ((a.transform).location.x IS NULL OR (a.transform).location.y IS NULL OR (a.transform).location.z IS NULL
                     OR (NOT (current_setting('mapclose.pawn_overrides')::jsonb ? c.player_pawn_id::text)
                         AND (a.transform).location IS DISTINCT FROM (c.pawn_transform).location))) THEN
    RAISE EXCEPTION 'map_close_move_readback_pawn_location';
  END IF;
  IF EXISTS (SELECT 1 FROM dune.encrypted_player_state WHERE character_state = 'Active'
              AND (home_dimension_index = @SRC_DIM@ OR return_dimension_index = @SRC_DIM@)) THEN
    RAISE EXCEPTION 'map_close_move_readback_home';
  END IF;
  IF EXISTS (SELECT 1 FROM unnest(string_to_array(current_setting('mapclose.recovery_vehicles'), ',')::bigint[]) v
              WHERE v > 0 AND NOT EXISTS (SELECT 1 FROM dune.recovered_vehicles rv JOIN dune.actors a ON a.id = rv.vehicle_id
                                           WHERE rv.vehicle_id = v AND a.state = 'VehicleRecovery' AND rv.reason = 'Migrated')
                 OR EXISTS (SELECT 1 FROM dune.permission_actor WHERE actor_id = v)) THEN
    RAISE EXCEPTION 'map_close_move_readback_recovery';
  END IF;
END $$;

SELECT 'map_close_move_verified' AS result,
       (SELECT count(*) FROM dune.@REC@_actors) AS actors,
       (SELECT count(*) FROM dune.@REC@_actors WHERE kind = 'vehicle') AS vehicles,
       (SELECT count(*) FROM dune.@REC@_actors z JOIN dune.totems t ON t.id = z.id) AS totems,
       (SELECT count(*) FROM dune.@REC@_characters WHERE pawn_partition = @SRC_PART@) AS pawns_moved,
       (SELECT count(*) FROM dune.@REC@_characters) AS characters_rehomed,
       (SELECT count(*) FROM dune.@REC@_respawns) AS respawns,
       (SELECT count(DISTINCT actor_id) FROM dune.@REC@_vehicle_perms) AS recovered_vehicles,
       (SELECT count(*) FROM k_hold) AS held_actors;
:end;

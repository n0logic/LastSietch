-- @SRC_NAME@ -> @DST_NAME@ overlap scan, part 2 (read-only; generated by map-close.py from overlap-loose.sql.in):
-- every non-base actor that will move (vehicles,
-- unowned placeables such as respawn beacons, unowned buildings, character pawns) against every destination
-- footprint cell (pieces, placeables, vehicles); and every destination vehicle against source base cells.
\set src @SRC_PART@
\set dst @DST_PART@
WITH ent_tot AS (
  SELECT afe.entity_id ent, a.id totem, a.partition_id p FROM dune.actors a JOIN dune.totems t ON t.id = a.id
    JOIN dune.actor_fgl_entities afe ON afe.actor_id = a.id AND afe.slot_name = 'Actor'
   WHERE a.partition_id IN (:src, :dst) AND a.state = 'Default'
), foot AS (  -- base footprint points per partition
  SELECT e.p, e.totem, bi.transform[0]::float8 x, bi.transform[1]::float8 y, bi.transform[2]::float8 z
    FROM ent_tot e JOIN dune.building_instances bi ON bi.owner_entity_id = e.ent
  UNION ALL
  SELECT e.p, e.totem, (a.transform).location.x, (a.transform).location.y, (a.transform).location.z
    FROM ent_tot e JOIN dune.placeables pl ON pl.owner_entity_id = e.ent JOIN dune.actors a ON a.id = pl.id
), loose AS (  -- actors that are not part of a base footprint
  SELECT a.partition_id p, a.id, CASE WHEN v.id IS NOT NULL THEN 'vehicle'
         WHEN a.class LIKE '%PlayerCharacter%' THEN 'pawn'
         WHEN b.id IS NOT NULL THEN 'unowned-building' ELSE 'unowned-placeable' END kind,
         (a.transform).location.x x, (a.transform).location.y y, (a.transform).location.z z
    FROM dune.actors a
    LEFT JOIN dune.vehicles v ON v.id = a.id
    LEFT JOIN dune.buildings b ON b.id = a.id
    LEFT JOIN dune.placeables pl ON pl.id = a.id
   WHERE a.partition_id IN (:src, :dst) AND a.state = 'Default'
     AND (v.id IS NOT NULL OR a.class LIKE '%PlayerCharacter%'
          OR (b.id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM dune.building_instances bi JOIN ent_tot e ON e.ent = bi.owner_entity_id WHERE bi.building_id = a.id))
          OR (pl.id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM dune.totems t WHERE t.id = a.id)
              AND (pl.owner_entity_id IS NULL OR pl.owner_entity_id NOT IN (SELECT ent FROM ent_tot))))
), fcell AS (
  SELECT p, totem, floor(x / 1000)::int cx, floor(y / 1000)::int cy, min(z) zmin, max(z) zmax FROM foot GROUP BY 1, 2, 3, 4
), hits AS (
  SELECT 'src-' || l.kind || '-vs-dst-base' what, l.id, f.totem other, min(abs(l.z - (f.zmin + f.zmax) / 2)) dz
    FROM loose l JOIN fcell f ON l.p = :src AND f.p = :dst AND abs(floor(l.x / 1000) - f.cx) <= 1 AND abs(floor(l.y / 1000) - f.cy) <= 1
   GROUP BY 1, 2, 3
  UNION ALL
  SELECT 'dst-' || l.kind || '-vs-src-base', l.id, f.totem, min(abs(l.z - (f.zmin + f.zmax) / 2))
    FROM loose l JOIN fcell f ON l.p = :dst AND f.p = :src AND abs(floor(l.x / 1000) - f.cx) <= 1 AND abs(floor(l.y / 1000) - f.cy) <= 1
   GROUP BY 1, 2, 3
  UNION ALL
  SELECT 'src-' || k.kind || '-vs-dst-' || m.kind, k.id, m.id, abs(k.z - m.z)
    FROM loose k JOIN loose m ON k.p = :src AND m.p = :dst AND abs(k.x - m.x) < 1500 AND abs(k.y - m.y) < 1500
)
SELECT what, id, other, round((dz / 100)::numeric, 1) dz_m FROM hits ORDER BY what, id;
SELECT p, kind, count(*) FROM (
  SELECT a.partition_id p, CASE WHEN v.id IS NOT NULL THEN 'vehicle' WHEN a.class LIKE '%PlayerCharacter%' THEN 'pawn' ELSE 'other' END kind
    FROM dune.actors a LEFT JOIN dune.vehicles v ON v.id = a.id
   WHERE a.partition_id IN (:src, :dst) AND a.state = 'Default' AND (v.id IS NOT NULL OR a.class LIKE '%PlayerCharacter%')) s
 GROUP BY 1, 2 ORDER BY 1, 2;

-- @SRC_NAME@ -> @DST_NAME@ overlap scan (read-only). Generated by map-close.py from overlap.sql.in. Instances of one
-- map share coordinates, so an actor moved to partition @DST_PART@ lands at the same x,y,z on @DST_NAME@. Footprint = 10 m cells (x,y) of every building piece and
-- placeable; z is kept per cell so "same plateau" (overlapping height) is separable from "under a cliff".
-- Run inside BEGIN READ ONLY ... ROLLBACK. Units are cm.
\set src @SRC_PART@
\set dst @DST_PART@
WITH tot AS (
  SELECT a.partition_id p, a.id totem, afe.entity_id ent
    FROM dune.actors a JOIN dune.totems t ON t.id = a.id
    JOIN dune.actor_fgl_entities afe ON afe.actor_id = a.id AND afe.slot_name = 'Actor'
   WHERE a.partition_id IN (:src, :dst) AND a.state = 'Default'
), pts AS (
  SELECT tot.p, tot.totem, bi.transform[0]::float8 x, bi.transform[1]::float8 y, bi.transform[2]::float8 z
    FROM tot JOIN dune.building_instances bi ON bi.owner_entity_id = tot.ent
  UNION ALL
  SELECT tot.p, tot.totem, (a.transform).location.x, (a.transform).location.y, (a.transform).location.z
    FROM tot JOIN dune.placeables pl ON pl.owner_entity_id = tot.ent JOIN dune.actors a ON a.id = pl.id
  UNION ALL
  SELECT tot.p, tot.totem, (a.transform).location.x, (a.transform).location.y, (a.transform).location.z
    FROM tot JOIN dune.actors a ON a.id = tot.totem
), cells AS (
  SELECT p, totem, floor(x / 1000)::int cx, floor(y / 1000)::int cy, min(z) zmin, max(z) zmax, count(*) n
    FROM pts GROUP BY 1, 2, 3, 4
), box AS (
  SELECT p, totem, min(x) x0, max(x) x1, min(y) y0, max(y) y1, count(*) n FROM pts GROUP BY 1, 2
), pair AS (
  SELECT k.totem k_totem, m.totem a_totem,
         greatest(0, greatest(k.x0 - m.x1, m.x0 - k.x1)) gx, greatest(0, greatest(k.y0 - m.y1, m.y0 - k.y1)) gy
    FROM box k JOIN box m ON k.p = :src AND m.p = :dst
), nearest AS (
  SELECT DISTINCT ON (k_totem) k_totem, a_totem, round((sqrt(gx * gx + gy * gy) / 100)::numeric, 1) bbox_gap_m
    FROM pair ORDER BY k_totem, gx * gx + gy * gy
), shared AS (
  SELECT k.totem k_totem, m.totem a_totem, count(*) cells2d,
         count(*) FILTER (WHERE k.zmin <= m.zmax + 500 AND m.zmin <= k.zmax + 500) cells_same_height
    FROM cells k JOIN cells m ON k.p = :src AND m.p = :dst AND k.cx = m.cx AND k.cy = m.cy
   GROUP BY 1, 2
), adjacent AS (
  SELECT k.totem k_totem, count(DISTINCT (k.cx, k.cy)) cells_within_20m
    FROM cells k JOIN cells m ON k.p = :src AND m.p = :dst AND abs(k.cx - m.cx) <= 2 AND abs(k.cy - m.cy) <= 2
   GROUP BY 1
)
SELECT n.k_totem, ok.player_id k_owner, okn.character_name k_owner_name, n.a_totem nearest_dst_totem,
       oan.character_name a_owner_name, n.bbox_gap_m, b.n k_points,
       (SELECT count(*) FROM cells c WHERE c.p = :src AND c.totem = n.k_totem) k_cells,
       coalesce(s.cells2d, 0) shared_cells, coalesce(s.cells_same_height, 0) shared_same_height,
       coalesce(j.cells_within_20m, 0) k_cells_within_20m,
       CASE WHEN coalesce(s.cells2d, 0) > 0 THEN 'OVERLAP'
            WHEN coalesce(j.cells_within_20m, 0) > 0 THEN 'WITHIN-20M'
            WHEN n.bbox_gap_m < 100 THEN 'BBOX<100M'
            ELSE 'clear' END verdict
  FROM nearest n JOIN box b ON b.p = :src AND b.totem = n.k_totem
  LEFT JOIN shared s ON s.k_totem = n.k_totem AND s.a_totem = n.a_totem
  LEFT JOIN adjacent j ON j.k_totem = n.k_totem
  LEFT JOIN dune.permission_actor_rank ok ON ok.permission_actor_id = n.k_totem AND ok.rank = 1
  LEFT JOIN dune.player_state okn ON okn.player_controller_id = ok.player_id
  LEFT JOIN dune.permission_actor_rank oa ON oa.permission_actor_id = n.a_totem AND oa.rank = 1
  LEFT JOIN dune.player_state oan ON oan.player_controller_id = oa.player_id
 ORDER BY (coalesce(s.cells2d, 0) > 0) DESC, (coalesce(j.cells_within_20m, 0) > 0) DESC, n.bbox_gap_m;

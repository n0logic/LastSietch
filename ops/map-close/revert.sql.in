-- Map close: undo the move from the @REC@_* record it wrote. Generated by map-close.py from revert.sql.in;
-- run ONLY through map-close.sh revert. Valid only while the whole move is still unplayed: BEFORE @DST_NAME@ reopens to players.
-- After players have touched the moved bases, reverting would erase their play; use the post-stop pg_dump and
-- per-base Base Vault work instead, owner's call.
-- Same live guard as the move: neither partition may have a game server holding a DB session.
-- Partition @SRC_PART@ must exist again (re-add it to the CR first if it was removed); the FK
-- actors.partition_id -> world_partition would refuse the restore otherwise.
\set ON_ERROR_STOP on
SET search_path TO dune, public;
BEGIN ISOLATION LEVEL REPEATABLE READ;
SET LOCAL statement_timeout = '300s';
SET LOCAL lock_timeout = '10s';
LOCK TABLE dune.actors, dune.permission_actor, dune.permission_actor_rank, dune.recovered_vehicles,
           dune.player_respawn_locations, dune.encrypted_player_state, dune.player_travel_state
  IN SHARE ROW EXCLUSIVE MODE;

DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM dune.world_partition w JOIN dune.active_server_ids s ON s.server_id = w.server_id
              WHERE w.partition_id IN (@SRC_PART@, @DST_PART@)) THEN
    RAISE EXCEPTION 'map_close_revert_partition_live';
  END IF;
  IF EXISTS (SELECT 1 FROM dune.player_state WHERE online_status <> 'Offline') THEN
    RAISE EXCEPTION 'map_close_revert_player_online';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM dune.world_partition WHERE partition_id = @SRC_PART@ AND map = '@PART_MAP@' AND dimension_index = @SRC_DIM@) THEN
    RAISE EXCEPTION 'map_close_revert_partition_missing: re-add partition @SRC_PART@ to the CR and wait for its row first';
  END IF;
  IF to_regclass('dune.@REC@_actors') IS NULL OR (SELECT reverted_at FROM dune.@REC@_meta) IS NOT NULL THEN
    RAISE EXCEPTION 'map_close_revert_no_record_or_already_reverted';
  END IF;
  -- Anything that is no longer where the move put it was changed after the move: stop and look, do not guess.
  IF EXISTS (SELECT 1 FROM dune.@REC@_actors z LEFT JOIN dune.actors a ON a.id = z.id
              WHERE a.id IS NULL OR a.partition_id <> @DST_PART@ OR a.dimension_index <> @DST_DIM@ OR a.state <> 'Default') THEN
    RAISE EXCEPTION 'map_close_revert_actor_changed_since_move';
  END IF;
END $$;

UPDATE dune.actors a SET partition_id = z.partition_id, dimension_index = z.dimension_index, map = z.map
  FROM dune.@REC@_actors z WHERE a.id = z.id;

UPDATE dune.player_respawn_locations r SET dimension = z.dimension
  FROM dune.@REC@_respawns z WHERE r.id = z.id AND r.character_id = z.character_id;

-- Recovery vehicles back into the world where they stood: the inverse of store_recovered_vehicle + the delete.
DELETE FROM dune.recovered_vehicles WHERE vehicle_id IN (SELECT DISTINCT actor_id FROM dune.@REC@_vehicle_perms);
UPDATE dune.actors SET state = 'Default' WHERE id IN (SELECT DISTINCT actor_id FROM dune.@REC@_vehicle_perms);
INSERT INTO dune.permission_actor (actor_id, actor_name, actor_type, access_level, is_child, edited_by_player_id)
  SELECT DISTINCT actor_id, actor_name, actor_type, access_level, is_child, edited_by_player_id FROM dune.@REC@_vehicle_perms;
INSERT INTO dune.permission_actor_rank (permission_actor_id, player_id, rank)
  SELECT actor_id, player_id, rank FROM dune.@REC@_vehicle_perms WHERE player_id IS NOT NULL;

UPDATE dune.actors a SET partition_id = c.pawn_partition, dimension_index = c.pawn_dimension, map = c.pawn_map,
                         transform = c.pawn_transform
  FROM dune.@REC@_characters c WHERE a.id = c.player_pawn_id AND c.pawn_partition = @SRC_PART@;
UPDATE dune.actors a SET partition_id = c.ctrl_partition, dimension_index = c.ctrl_dimension
  FROM dune.@REC@_characters c WHERE a.id = c.player_controller_id AND c.pawn_partition = @SRC_PART@ AND c.ctrl_partition = @SRC_PART@;
UPDATE dune.actors a SET partition_id = c.state_partition, dimension_index = c.state_dimension
  FROM dune.@REC@_characters c WHERE a.id = c.player_state_id AND c.pawn_partition = @SRC_PART@ AND c.state_partition = @SRC_PART@;
UPDATE dune.encrypted_player_state e SET home_dimension_index = c.home_dimension_index,
                                         return_dimension_index = c.return_dimension_index
  FROM dune.@REC@_characters c WHERE e.id = c.eps_id;
UPDATE dune.player_travel_state t SET login_target_dimension_index = c.login_target_dimension_index
  FROM dune.@REC@_characters c WHERE t.fls_id = c.fls AND c.login_target_dimension_index IS NOT NULL;

UPDATE dune.@REC@_meta SET reverted_at = now();

DO $$ BEGIN
  IF EXISTS (SELECT 1 FROM dune.@REC@_actors z JOIN dune.actors a ON a.id = z.id
              WHERE (a.partition_id, a.dimension_index, a.map) IS DISTINCT FROM (z.partition_id, z.dimension_index, z.map)) THEN
    RAISE EXCEPTION 'map_close_revert_readback_actors';
  END IF;
  IF EXISTS (SELECT 1 FROM dune.@REC@_characters c JOIN dune.actors a ON a.id = c.player_pawn_id
              WHERE c.pawn_partition = @SRC_PART@ AND a.partition_id <> @SRC_PART@) THEN
    RAISE EXCEPTION 'map_close_revert_readback_pawns';
  END IF;
END $$;

SELECT 'map_close_revert_verified' AS result, (SELECT count(*) FROM dune.@REC@_actors) AS actors,
       (SELECT count(*) FROM dune.@REC@_characters) AS characters;
:end;

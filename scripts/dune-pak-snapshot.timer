[Unit]
Description=Daily Dune pak content snapshot @ 04:00 ET
Documentation=https://github.com/n0logic/House0fL0gic/blob/main/docs/dune-research/PAK-SNAPSHOT-DESIGN.md

[Timer]
# 04:00 America/New_York. ET shifts between EST (UTC-5) and EDT (UTC-4),
# so anchor to local time which systemd handles via the host TZ.
OnCalendar=*-*-* 04:00:00 America/New_York
Persistent=true
RandomizedDelaySec=120
Unit=dune-pak-snapshot.service

[Install]
WantedBy=timers.target
